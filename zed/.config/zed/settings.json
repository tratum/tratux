{
  "base_keymap": "VSCode",
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 24,
  "buffer_font_size": 20,
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "Colorizer"
