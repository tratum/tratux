  "icon_theme": "Material Icon Theme",
  "tab_size": 2,
  "format_on_save": "on",
  "use_autoclose": true,
  "show_whitespaces": "all",
  "soft_wrap": "editor_width",
  "unnecessary_code_fade": 0.5,
  "restore_on_startup": "last_session",
  "remove_trailing_whitespace_on_save": true,
  "show_edit_predictions": false,
  "tabs": {
