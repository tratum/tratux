// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "VSCode",
  "ui_font_family": "JetBrains Mono",
  "ui_font_size": 24,
  "buffer_font_size": 20,
  "theme": {
    "mode": "system",
    "light": "Dawnfox - blurred",
    "dark": "Colorizer"
  },
  "icon_theme": "Material Icon Theme",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true
  },
  "scrollbar": {
    "show": "auto"
  },
  "tab_bar": {
    "show": false
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_code_navigation": false
  },
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "shell": {
      "program": "zsh"
    },
    "line_height": "comfortable",
    "blinking": "on",
    "copy_on_select": true,
    "font_family": "JetBrains Mono",
    "font_size": 18,
    "working_directory": "current_project_directory"
  },
  "project_panel": {
    "button": true,
    "default_width": 280,
    "dock": "left",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": null
    },
    "show_diagnostics": "all",
    "indent_guides": {
      "show": "always"
    }
  },
  "outline_panel": {
    "button": true,
    "default_width": 400,
    "dock": "left",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "indent_guides": {
      "show": "always"
    },
    "scrollbar": {
      "show": null
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "tab_size": 2,
  "format_on_save": "on",
  "use_autoclose": true,
  "show_whitespaces": "all",
  "soft_wrap": "editor_width",
  "unnecessary_code_fade": 0.5,
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_session"
}
