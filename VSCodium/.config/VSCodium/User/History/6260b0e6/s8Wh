    background ~/.config/.current_wallpaper fill
}

# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration ------------------------------------------------------------------------------------

exec LT="$lock_timeout" ST="$screen_timeout" LT=${LT:-300} ST=${ST:-60} && \
    hypridle -w \
        timeout $LT 'hyprlock -f' \
        timeout $((LT + ST)) 'swaymsg "output * power off"' \
                      resume 'swaymsg "output * power on"'  \
        timeout $ST 'pgrep -xu "$USER" hyprlock >/dev/null && swaymsg "output * power off"' \
             resume 'pgrep -xu "$USER" hyprlock >/dev/null && swaymsg "output * power on"'  \
        before-sleep 'hyprlock -f' \
        lock 'hyprlock -f' \
        unlock 'pkill -xu "$USER" -SIGUSR1 hyprlock'

