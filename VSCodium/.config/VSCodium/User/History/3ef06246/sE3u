    "format": "",
    "interval": "once",
    "tooltip": false
},
"custom/separator#line": {
    "format": "|",
    "interval": "once",
    "tooltip": false
},
"custom/separator#blank": {
    "format": "",
    "interval": "once",
    "tooltip": false
},
"custom/separator#blank_2": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
},
"custom/separator#blank_3": {
    "format": "   ",
    "interval": "once",
    "tooltip": false
},
