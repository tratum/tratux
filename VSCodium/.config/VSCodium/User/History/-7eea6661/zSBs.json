{
    // Allow opening untrusted files without prompt
    "security.workspace.trust.untrustedFiles": "open",
  
    // Icon and color themes
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.colorTheme": "Default Light+",
    "window.titleBarStyle": "custom",
  
    // Auto‑save and word wrap
    "files.autoSave": "afterDelay",
    "editor.wordWrap": "on",
  
    // File associations
    "files.associations": {
      "config": "c"
    },
  
    // Prettier as default formatter for JSON & CSS
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
  
    // Unicode highlighting for non‑ASCII
    "editor.unicodeHighlight.nonBasicASCII": true,
  
    // Trust dark/light auto‑detection
    "window.autoDetectColorScheme": true,
  
    // Hide status bar if desired
    "workbench.statusBar.visible": false,
  
    // —————— Zig Language Server Configuration ——————  
    "zig.zls.enabled": "on",
    "zig.path": "/home/tratum/Software/zig/zig-0.14/zig",
    "zig.version": "0.14.0",
    "zig.zls.path": "/home/tratum/Software/zig/zig-0.14/zls",
  
    "zig.zls.highlightGlobalVarDeclarations": true,
  
    "workbench.settings.applyToAllProfiles": [
      "zig.path",
      "zig.version",
      "zig.zls.path",
      "zig.zls.enabled"
    ],
    "explorer.confirmDelete": false,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "explorer.confirmDragAndDrop": false,
    "editor.fontFamily": "'JetBrains Mono'",
    "editor.fontSize": 16,
    "terminal.integrated.fontFamily": "'JetBrains Mono'",
    "nebulaOni.update.restoreConfiguration": {
      "themeSettings": {
        "background": "Dark Grey",
        "main": "Sakura",
        "highlight": "Ultra Violet",
        "focusBorder": "ON",
        "fontStyle": "Italic",
        "syntaxBrightness": "Normal",
        "comments": "Dark Violet",
        "favorite": "OFF"
      },
      "favoriteSettings": {
        "background": "Glacial Blue",
        "main": "Sakura",
        "highlight": "Ultra Violet",
        "focusBorder": "ON",
        "fontStyle": "Italic",
        "syntaxBrightness": "Dimmed",
        "comments": "Dark Magenta",
        "favorite": "Nebula Oni (Pegasus)"
      }
    },
    "workbench.preferredDarkColorTheme": "Nebula Oni (Pegasus)",
    "nebulaOni.color.backgroundColor": "Dark Grey",
    "nebulaOni.color.mainColor": "Sakura",
    "nebulaOni.applyChanges": false,
    "nebulaOni.add.favorite": "OFF",
    "window.openFilesInNewWindow": "on",
    "editor.inlayHints.fontFamily": "'JetBrains Mono'",
    "editor.inlineSuggest.fontFamily": "'JetBrains Mono'",

  }
  